node_modules/
dist/
# electron-builder 산출물. 백신이 dist/를 잠그면 --config.directories.output으로
# 다른 이름에 빌드하게 되는데, 그때도 저장소에 들어오지 않게 한다
dist-*/
.env

.firebase/

# 빌드 결과물 (firebase deploy 전 npm run build 필요)
# portal/assets/ — Vite 번들 (매 빌드마다 해시값 변경)
# portal/manual/ — manual/ 소스에서 빌드 시 자동 복사
portal/assets/
portal/manual/
dashboard/assets/

# Claude Code
.claude/

# Python (tools/)
__pycache__/
*.pyc
.venv/
venv/

# 실제 학생 개인정보(이름·성적)가 담긴 나이스 원본 파일 — 절대 커밋 금지
tools/docs/
kiosk/assets/

# 파일 동기화 도구(iCloud/Dropbox 등)가 충돌 시 만드는 사본.
# "TargetPicker 2.jsx"처럼 이름 끝에 공백과 숫자가 붙는다. import는 원본으로 걸리므로
# 빌드에는 안 들어가지만, 저장소에 쌓이면 어느 쪽이 진짜인지 헷갈린다.
# 확장자를 가리지 않는다 — 소스뿐 아니라 빌드 산출물(.html·.svg)에도 생긴다.
* [0-9].*
