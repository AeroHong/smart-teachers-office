rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // [C-1] Custom Claims 방식 — 이메일 하드코딩 제거
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role in ['admin', 'school_admin'];
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() &&
        getUserData().role in ['admin', 'school_admin'] &&
        getUserData().schoolId == schoolId;
    }

    function isTeacher(schoolId) {
      return isSignedIn() &&
        getUserData().role in ['teacher', 'admin', 'school_admin', 'principal'] &&
        getUserData().schoolId == schoolId;
    }

    function isPrincipal(schoolId) {
      return isSignedIn() &&
        getUserData().role == 'principal' &&
        getUserData().schoolId == schoolId;
    }

    function isStudent(schoolId) {
      return isSignedIn() &&
        getUserData().role == 'student' &&
        getUserData().schoolId == schoolId;
    }

    // 업무 요청의 완료 토글 검사 — completedUids에서 움직인 uid가 본인뿐인지 본다.
    // 이게 없으면 대상 교사가 남의 완료를 대신 체크하거나 지울 수 있다.
    // (빈 집합도 hasOnly를 통과하므로 넣기·빼기·변화 없음이 모두 허용된다)
    function selfOnlyCompletionChange() {
      let before = resource.data.get('completedUids', []).toSet();
      let after = request.resource.data.get('completedUids', []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) &&
             before.difference(after).hasOnly([request.auth.uid]);
    }

    // 호출 시스템 키오스크 기기 — 관리자가 발급한 페어링 코드로 Custom Claims를 받은
    // 익명 계정만 통과. 사무실(kioskOffice) 단위까지 범위를 좁힌다.
    function isKioskDevice(schoolId) {
      return isSignedIn() && request.auth.token.kioskSchoolId == schoolId;
    }

    // asaSubmissions 문서 자체의 teacherEmails는 생성 시점 스냅샷이라, 나중에 asaSubjects에서
    // 교사가 추가/제거돼도 기존 submission 문서에는 반영되지 않아 배정 현황과 어긋날 수 있다.
    // 그래서 배정 여부는 항상 asaSubjects의 실시간 값으로 판단한다.
    //
    // 교사 식별을 이메일 → uid로 옮기는 중이라 두 필드를 모두 본다.
    //  - teacherUids: 신규/백필된 문서 (계정 이메일이 바뀌어도 유지됨)
    //  - teacherEmails: 아직 백필되지 않은 기존 문서 폴백
    // 한쪽만 맞아도 통과시켜 전환 도중 담당 교사가 잠기지 않게 한다.
    // .get(key, []) 를 쓰므로 필드가 아예 없는 문서에서도 규칙 평가가 실패하지 않는다.
    function isAssignedToAsaSubject(schoolId, subjectId) {
      let subject = get(/databases/$(database)/documents/schools/$(schoolId)/asaSubjects/$(subjectId)).data;
      return request.auth.uid in subject.get('teacherUids', []) ||
             request.auth.token.email in subject.get('teacherEmails', []);
    }

    // ── /studentRegistrations — 학생 자동 등록용 이메일 색인 ───────
    match /studentRegistrations/{email} {
      allow get: if isSignedIn() && email == request.auth.token.email;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() || isTeacher(request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isTeacher(resource.data.schoolId);
    }

    // ── /schoolDomains — get만 허용 (auth 흐름 자기 도메인 조회) ──────
    match /schoolDomains/{domain} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── /kioskPairingCodes — 호출 시스템 기기 페어링 코드 ─────────
    // 발급·검증 모두 콜러블 함수(Admin SDK)에서만 처리하므로 클라이언트 접근은 전면 차단.
    // (코드를 클라이언트가 조회할 수 있으면 무작위 대입으로 기기 권한을 탈취할 수 있음)
    match /kioskPairingCodes/{code} {
      allow read, write: if false;
    }

    // ── /auditLogs ──────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();  // SchoolSetup·SuperAdmin 모두 기록
      allow update, delete: if isSuperAdmin();
    }

    // ── /users ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['pending', 'student', 'school_admin', 'teacher'];
      allow update: if isSuperAdmin() || isAdmin() ||
                    (isSignedIn() && request.auth.uid == uid &&
                     request.resource.data.role == resource.data.role &&
                     request.resource.data.schoolId == resource.data.schoolId) ||
                    // [M-2] 게스트 → 실제 학교 전환: role은 pending/teacher만 허용 (admin 제외)
                    (isSignedIn() && request.auth.uid == uid &&
                     resource.data.schoolId.matches('guest_.*') &&
                     request.resource.data.role in ['pending', 'teacher']) ||
                    // [M-4] 학생 이메일 패턴으로 본인 역할 복구 (rejected/pending → student)
                    (isSignedIn() && request.auth.uid == uid &&
                     resource.data.role in ['rejected', 'pending'] &&
                     request.resource.data.role == 'student' &&
                     request.auth.token.email.matches('[0-9]{9}@.*'));
      allow delete: if isSuperAdmin();
      // 같은 학교 구성원 목록은 소속 교사도 조회할 수 있어야 한다.
      // 쪽지 받는 사람 선택과 대시보드 구성원 명단이 이 목록을 쓰는데, 관리자만 허용하면
      // 일반 교사에게는 두 기능이 통째로 막힌다 (권한 오류로 조용히 실패했었음).
      //
      // 클라이언트가 where('schoolId','==',내학교)로 좁혀 조회하고, 아래 조건이 문서마다
      // 그 값을 다시 검증하므로 다른 학교 계정은 결과에 섞이지 않는다.
      // getUserData()는 모든 문서에서 같은 경로라 규칙 엔진이 한 번만 읽는다.
      allow list: if isSuperAdmin() || isAdmin() ||
                  (isSignedIn() && resource.data.schoolId == getUserData().schoolId);
    }

    // ── /schools ─────────────────────────────────────────────────
    match /schools/{schoolId} {
      // [H-1] get/list 분리 — list는 관리자만, 단건 get은 SchoolSetup 미가입자도 허용
      allow get: if isSuperAdmin() || isTeacher(schoolId) || isSignedIn();
      // [FIX] list는 원래 관리자/소속 교사만 허용하려 했으나, schoolId는 문서마다 달라지는
      // 와일드카드라 컬렉션 전체를 조회하는 list 쿼리에서는 isTeacher(schoolId)가 절대 참이 될 수
      // 없어 SchoolSetup의 학교 검색이 슈퍼 어드민 외 전원에게 permission-denied로 막혀 있었음.
      // users 문서가 아직 없는(온보딩 전) 계정과 rejected 계정은 학교 목록을 조회할 수 있어야
      // SchoolSetup에서 소속 학교를 찾아 가입 신청할 수 있다.
      allow list: if isSuperAdmin() || isTeacher(schoolId) ||
        (isSignedIn() &&
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
           getUserData().role == 'rejected'));
      // 일반 사용자: school- 접두사 학교만 생성 가능 (SchoolSetup 자동 생성)
      allow create: if isSuperAdmin() ||
        (isSignedIn() && schoolId.matches('school-.*') && request.resource.data.createdBy == request.auth.token.email) ||
        (isSignedIn() && schoolId.matches('guest_.*') && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isSuperAdmin() || isSchoolAdmin(schoolId);
      allow delete: if isSuperAdmin();

      // 보강 신청 — 소속 학교 구성원만 ────────────────────────────
      match /coverRequests/{requestId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow create: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow update: if isSuperAdmin() || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      match /teachers/{teacherId} {
        allow read, write: if isSuperAdmin() || isTeacher(schoolId);
      }

      // tasks 컬렉션은 업무 요청(requests)으로 통합되면서 제거했다.
      // 담당자를 여럿 지정해도 status가 하나뿐이라 "누가 안 했나"를 물을 수 없는 구조였고,
      // 할 일 목록이 요청과 둘로 갈려 있는 것도 문제였다. 남은 문서는 접근 경로가 없다.

      // 전체 공지(announcements)는 업무 글(requests)의 kind='notice'로 통합됐다.
      // 관리자만 쓸 수 있었으나 실제로 안내를 내는 사람은 교무부 담당 교사라 권한이 맞지
      // 않았고, 요청과 필요한 것이 같아 화면·모델을 한 벌로 합쳤다.

      // 학사일정 — 관리자만 쓰기, 소속 교사 전체 읽기
      match /academicCalendar/{eventId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 개인 쪽지 — 발신자만 생성, 발신자·수신자만 읽기/삭제.
      // 읽음 처리(readAt)는 수신자가 update로 하므로 발신자·수신자 모두 update 허용 범위에 둔다
      // (본문 위·변조는 클라이언트 UI에서 막고, 규칙은 문서 소유 여부까지만 판정한다).
      match /personalNotices/{noticeId} {
        allow read: if isSuperAdmin() ||
          (isTeacher(schoolId) && (
            resource.data.senderUid == request.auth.uid ||
            resource.data.recipientUid == request.auth.uid
          ));
        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.resource.data.senderUid == request.auth.uid);
        allow update: if isSuperAdmin() ||
          (isTeacher(schoolId) && (
            resource.data.senderUid == request.auth.uid ||
            resource.data.recipientUid == request.auth.uid
          ));
        allow delete: if isSuperAdmin() ||
          (isTeacher(schoolId) && resource.data.senderUid == request.auth.uid);
      }

      // 업무 요청 — 사람마다 완료 여부가 생기는 일 (원안 제출, 성적 마감 등)
      //
      // 만들기는 소속 교사 누구나 할 수 있다. 지금도 쿨메신저로 누구나 전체 발송이 되고,
      // 여기서는 최소한 누가 만들었는지가 남는다.
      //
      // 완료 표시가 이 규칙의 핵심이다. 대상 교사는 요청 문서의 completedUids에 자기 uid만
      // 넣고 뺄 수 있어야 하고, 제목·마감일·대상 명단은 건드릴 수 없어야 한다.
      // 채널 — 업무 글이 모이는 곳. 글에 붙는 이름표라 별도 글 컬렉션이 없다.
      //
      // 읽기를 소속 교사 전체에 여는 이유: 참여자만 읽게 하면 채널 이름조차 볼 수 없어
      // "그 채널에 넣어달라"는 말을 꺼낼 수가 없다. 채널에 든 글은 requests 규칙이
      // 따로 지키므로 채널 문서가 열려도 내용이 새지 않는다.
      //
      // 고치기를 만든 사람과 관리자로 묶는 이유: 참여자 조건을 아무나 바꾸면 대상이
      // 조용히 넓어지거나 좁아지는데, 그 변화가 채널을 열기 전에는 드러나지 않는다.
      match /channels/{channelId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);

        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.resource.data.createdBy == request.auth.uid);

        allow update, delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);
      }

      match /requests/{requestId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);

        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) &&
           request.resource.data.createdBy == request.auth.uid &&
           request.resource.data.completedUids.size() == 0);

        // 요청 내용 수정·마감은 만든 사람과 관리자만
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid) ||
          // 대상 교사의 완료 토글 — 바뀌는 필드도, 그 안에서 움직이는 uid도 제한한다
          (isTeacher(schoolId) &&
           request.auth.uid in resource.data.targetUids &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['completedUids', 'updatedAt']) &&
           selfOnlyCompletionChange());

        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);

        // 완료 상세(시각·비고). 문서 ID가 곧 uid다.
        // 읽기를 소속 교사 전체에 여는 이유는 현황 화면이 누가 언제 했는지를 보여주기 때문.
        // 어차피 요청 문서의 completedUids로 완료 여부는 드러나므로 새로 노출되는 정보가 아니다.
        match /completions/{completionUid} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);
          allow write: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
            // 본인이 체크
            (isTeacher(schoolId) && completionUid == request.auth.uid) ||
            // 담당자가 확인 후 대신 체크 (완료 버튼을 안 누르는 사람이 반드시 있다)
            (isTeacher(schoolId) &&
             get(/databases/$(database)/documents/schools/$(schoolId)/requests/$(requestId))
               .data.createdBy == request.auth.uid);
        }
      }

      // 대시보드 위젯 노출 제어 — 관리자만 쓰기, 소속 교사 전체 읽기
      // (자신이 대상인지는 department/uid 비교로 클라이언트가 판정 — enabled 여부만 서버가 강제)
      match /dashboardModules/{moduleId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 학생 — 소속 학교 구성원만 ──────────────────────────────────
      match /students/{studentId} {
        // 학생 본인도 자신의 학생 정보를 읽을 수 있음 (QR 체크인용)
        allow read: if isSuperAdmin() || isTeacher(schoolId) ||
          (isStudent(schoolId) && getUserData().studentId == studentId);
        allow write: if isSuperAdmin() || isTeacher(schoolId);
      }

      // 연도별 교원 배정 정보(담당교과·부서·담임·좌석·직함) — 조회는 소속 교사 전체, 쓰기는 관리자만
      match /teacherAssignments/{assignmentId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교육과정 과목 정보 (입학년도-학년-학기별) — 조회는 소속 교사 전체, 쓰기는 관리자만
      match /subjects/{subjectId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교사 과목 배정 (학기별 담당 과목) — 조회는 소속 교사 전체, 쓰기는 관리자만
      match /teacherSubjects/{subjectAssignmentId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교사 재실 상태 — 본인만 쓰고, 소속 교사와 키오스크(자리 표시용)가 읽는다.
      // 추후 Electron 데스크톱 클라이언트도 본인 문서를 자동 갱신한다.
      match /presence/{uid} {
        allow read: if isSuperAdmin() || isTeacher(schoolId) || isKioskDevice(schoolId);
        allow write: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.auth.uid == uid);
      }

      // 사무실 자리 배치 (교사 카드 좌표) — 조회는 소속 교사, 편집은 관리자만.
      // 키오스크는 getKioskTeachers 콜러블을 통해 받으므로 직접 읽기 권한은 주지 않는다.
      match /officeLayouts/{layoutId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 선생님 호출 — 생성은 콜러블(submitCallRequest)에서만 처리하므로 클라이언트 create 금지.
      // 현황판 기기는 자기 사무실 호출만 읽고, 확인·완료 처리는 로그인한 교사만 가능.
      match /callRequests/{requestId} {
        // list는 반환되는 모든 문서에 대해 이 규칙이 통과해야 성공하므로,
        // 키오스크가 office 필터 없이 전체를 조회하면 자동으로 거부된다.
        allow read: if isSuperAdmin() || isTeacher(schoolId) ||
          (isKioskDevice(schoolId) && resource.data.office == request.auth.token.kioskOffice);
        allow create: if false;
        allow update: if isSuperAdmin() || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      match /studentGroups/{groupId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId) ||
          (isSignedIn() && resource.data.createdBy == request.auth.uid) ||
          (isStudent(schoolId) && resource.data.studentIds.hasAny([getUserData().studentId]));
        allow write: if isSuperAdmin() || isTeacher(schoolId) ||
          (isSignedIn() && (resource.data.createdBy == request.auth.uid ||
                            request.resource.data.createdBy == request.auth.uid));
      }

      match /courses/{courseId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isTeacher(schoolId);
      }

      // 이벤트 — QR 체크인(공개 get) 허용 ─────────────────────────
      match /events/{eventId} {
        allow get: if true;  // QR 체크인: 미로그인 학생 접근
        allow list: if isSuperAdmin() || isTeacher(schoolId) || isStudent(schoolId);
        allow write: if isSuperAdmin() || isTeacher(schoolId);

        match /attendanceLogs/{logId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);
          // 학생 본인의 출결 로그 확인 (중복 체크인 방지용 get)
          allow get: if isStudent(schoolId) &&
            (resource == null || resource.data.studentId == getUserData().studentId);
          // 학생: 순위 계산용 list (같은 학교 학생끼리 출석 현황 확인)
          allow list: if isStudent(schoolId);
          // [H-2] isSignedIn() 추가 — QR 토큰만으로 비로그인 쓰기 불가
          allow write: if isSuperAdmin() || isTeacher(schoolId) ||
            (isSignedIn() && (
              get(/databases/$(database)/documents/schools/$(schoolId)/events/$(eventId)).data.qrToken
                == request.resource.data.qrToken ||
              get(/databases/$(database)/documents/schools/$(schoolId)/events/$(eventId)).data.liveToken
                == request.resource.data.qrToken
            ));
        }

      }

      match /trainings/{trainingId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow create: if isSuperAdmin() || isTeacher(schoolId);
        allow update: if isSuperAdmin() || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isAdmin() ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);

        match /signatures/{signatureId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);
          allow write: if isSuperAdmin() ||
            (isTeacher(schoolId) && request.auth.uid == signatureId);
        }
      }

      match /trainingPresets/{presetId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isAdmin();
      }

      // 스마트 공지 — 본인 공지 쓰기, 소속 학교 구성원 읽기
      match /notices/{noticeId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId) || isStudent(schoolId);
        allow write: if isSuperAdmin() ||
          (isTeacher(schoolId) && (
            resource == null || resource.data.teacherId == request.auth.uid
          ));

        // 공지 확인 기록 — 학생 본인만 쓰기, 교사는 읽기 가능
        match /confirmations/{confirmedStudentId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId) ||
            (isStudent(schoolId) && getUserData().studentId == confirmedStudentId);
          allow create, update: if isSuperAdmin() ||
            (isStudent(schoolId) && getUserData().studentId == confirmedStudentId);
          allow delete: if isSuperAdmin() || isTeacher(schoolId);
        }
      }

      // [M-3] preApproved — 본인 이메일 문서만 get 허용, 목록은 해당 학교 관리자 이상
      // [FIX] 문서 ID는 이메일을 변환한 값(emailToDocId)이라 emailId와 원본 이메일이 항상
      // 달라 get이 실질적으로 막혀 있었음 — 문서 데이터의 email 필드로 비교하도록 수정
      match /preApproved/{emailId} {
        allow get: if isSignedIn() && resource.data.email == request.auth.token.email;
        allow list: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // ── 성취평가제 운영 체크리스트 (ASA-checklist) ──────────────
      // 과목 — 관리자만 생성/수정, 교사·교감은 조회
      match /asaSubjects/{subjectId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 나이스 담당과목 업로드 이력 — 관리자만 (교사 로스터 데이터, 관리 목적 전용)
      match /asaNeisImports/{importId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 제출물 — 배정된 교사·교감은 읽기/수정, 관리자는 전체, 잠금(locked) 후 수정 불가
      // 배정 여부는 문서 자체의 teacherEmails(스냅샷)가 아니라 asaSubjects의 실시간 값으로 판단
      match /asaSubmissions/{submissionId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) || isPrincipal(schoolId) ||
          (isTeacher(schoolId) && isAssignedToAsaSubject(schoolId, resource.data.subjectId));
        allow create: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && isAssignedToAsaSubject(schoolId, request.resource.data.subjectId));
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) || isPrincipal(schoolId) ||
          (isTeacher(schoolId) &&
           isAssignedToAsaSubject(schoolId, resource.data.subjectId) &&
           resource.data.status != 'locked');
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교감 서명 재사용 저장소 — 본인만 읽기/쓰기, 관리자는 읽기
      match /asaPrincipalSignature/{uid} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isSignedIn() && request.auth.uid == uid);
        allow write: if isSuperAdmin() ||
          (isPrincipal(schoolId) && request.auth.uid == uid);
      }

      // 성취평가제 체크리스트 지원 도구 (ASA-support)
      // 분할점수 기준 — 조회는 소속 교사 전체, 등록/수정/삭제는 관리자만
      match /asaCutoffs/{cutoffId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 분석 결과 — 업로드한 본인 교사만 조회/수정/삭제 (관리자는 전체 열람 가능)
      match /asaResults/{resultId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);
        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.resource.data.createdBy == request.auth.uid);
        allow update, delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);
      }

      // 최소성취수준 보장지도 결과 — 조회는 소속 교사 전체, 쓰기는 본인 doc만 (관리자는 전체)
      match /minAchievementResults/{resultId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow create, update: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resultId.matches(request.auth.uid + '_.*'));
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resultId.matches(request.auth.uid + '_.*'));
      }
    }
  }
}
