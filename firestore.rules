rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // [C-1] Custom Claims 방식 — 이메일 하드코딩 제거
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role in ['admin', 'school_admin'];
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() &&
        getUserData().role in ['admin', 'school_admin'] &&
        getUserData().schoolId == schoolId;
    }

    function isTeacher(schoolId) {
      return isSignedIn() &&
        getUserData().role in ['teacher', 'admin', 'school_admin', 'principal'] &&
        getUserData().schoolId == schoolId;
    }

    function isPrincipal(schoolId) {
      return isSignedIn() &&
        getUserData().role == 'principal' &&
        getUserData().schoolId == schoolId;
    }

    function isStudent(schoolId) {
      return isSignedIn() &&
        getUserData().role == 'student' &&
        getUserData().schoolId == schoolId;
    }

    // uid 목록에서 움직인 값이 본인뿐인지 본다.
    //
    // "완료 체크"와 "채널 나가기"가 같은 모양이다 — 남의 uid를 넣거나 빼면 안 되고,
    // 자기 것만 넣거나 뺄 수 있다. 이게 없으면 대상 교사가 남의 완료를 대신 체크하거나
    // 남을 채널에서 내보낼 수 있다.
    //
    // 빈 집합도 hasOnly를 통과하므로 넣기·빼기·변화 없음이 모두 허용된다.
    // 공지 전용 채널(postPolicy == 'owner')에는 만든 사람만 글을 쓴다.
    //
    // 글 하나를 만드는 단일 문서 쓰기라 여기서는 get()을 써도 된다. 목록 쿼리와 달리
    // 문서 접근 상한에 걸리지 않고, 쿼리 안전성 증명 문제도 없다.
    //
    // .get('postPolicy', 'members')로 읽는 이유: 이 필드가 생기기 전 채널에는 값이 없다.
    // 백필로 채웠지만, 값이 빠진 문서 하나에 글쓰기가 통째로 막히는 실패 모드를 만들지 않는다.
    function channelData(schoolId, channelId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/channels/$(channelId)).data;
    }

    function channelAllowsPost(schoolId, channelId) {
      let ch = channelData(schoolId, channelId);
      return ch.get('postPolicy', 'members') == 'members' || ch.createdBy == request.auth.uid;
    }

    // ── DM (2026-08-24, P2b) ──
    //
    // DM은 "이름 없는 2인 채널"이라 채널과 같은 컬렉션에 산다. 그래서 문서 ID를 두 uid로
    // 못 박아 둔 것이 규칙에서도 쓸모가 있다 — 같은 상대와 DM이 두 개 생기지 않는다는
    // 보장이 클라이언트의 약속이 아니라 서버의 조건이 된다.
    //
    // 정렬 순서(memberUids[0] < memberUids[1])까지 검사하는 이유: 정렬하지 않으면 같은
    // 두 사람이 dm_A_B와 dm_B_A 두 문서를 만들 수 있고, 그러면 대화가 둘로 갈라진 뒤
    // 어느 쪽에 답했는지 알 수 없게 된다. 규칙에는 정렬 함수가 없어 비교로 대신한다.
    function isValidDmCreate(channelId) {
      let d = request.resource.data;
      return d.type == 'dm' &&
             d.visibility == 'private' &&
             d.memberUids.size() == 2 &&
             d.memberUids[0] < d.memberUids[1] &&
             request.auth.uid in d.memberUids &&
             channelId == 'dm_' + d.memberUids[0] + '_' + d.memberUids[1];
    }

    // 채널 하위 메시지에서 쓰는 참여 판정.
    //
    // 채널 문서 자체의 read 규칙과 달리 여기서는 get()을 써도 된다 — 메시지는 항상 채널
    // 하나 안에서만 조회되어 channelId가 경로에 고정되므로, 목록 쿼리 하나에 get()이
    // 한 번만 일어난다. 문서 접근 상한에 걸리지 않고 쿼리 안전성도 증명된다.
    //
    // 나간 사람(leftUids)을 빼지 않는 이유: 채널 문서 read와 같은 기준을 쓴다. 나가기는
    // "내 목록에서 접기"이지 권한 회수가 아니고, 다시 참여할 자리도 남겨야 한다.
    function isChannelMember(schoolId, channelId) {
      return isTeacher(schoolId) &&
        request.auth.uid in channelData(schoolId, channelId).get('memberUids', []);
    }

    function selfOnlyUidChange(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) &&
             before.difference(after).hasOnly([request.auth.uid]);
    }

    // 호출 시스템 키오스크 기기 — 관리자가 발급한 페어링 코드로 Custom Claims를 받은
    // 익명 계정만 통과. 사무실(kioskOffice) 단위까지 범위를 좁힌다.
    function isKioskDevice(schoolId) {
      return isSignedIn() && request.auth.token.kioskSchoolId == schoolId;
    }

    // asaSubmissions 문서 자체의 teacherEmails는 생성 시점 스냅샷이라, 나중에 asaSubjects에서
    // 교사가 추가/제거돼도 기존 submission 문서에는 반영되지 않아 배정 현황과 어긋날 수 있다.
    // 그래서 배정 여부는 항상 asaSubjects의 실시간 값으로 판단한다.
    //
    // 교사 식별을 이메일 → uid로 옮기는 중이라 두 필드를 모두 본다.
    //  - teacherUids: 신규/백필된 문서 (계정 이메일이 바뀌어도 유지됨)
    //  - teacherEmails: 아직 백필되지 않은 기존 문서 폴백
    // 한쪽만 맞아도 통과시켜 전환 도중 담당 교사가 잠기지 않게 한다.
    // .get(key, []) 를 쓰므로 필드가 아예 없는 문서에서도 규칙 평가가 실패하지 않는다.
    function isAssignedToAsaSubject(schoolId, subjectId) {
      let subject = get(/databases/$(database)/documents/schools/$(schoolId)/asaSubjects/$(subjectId)).data;
      return request.auth.uid in subject.get('teacherUids', []) ||
             request.auth.token.email in subject.get('teacherEmails', []);
    }

    // 교수학습 및 평가 운영 계획 "업무 담당자" — 학교 전체 단일 목록. 존재 여부만으로
    // 담당자인지 판정하므로 uid를 문서 ID로 쓴다(evaluationPlanManagers/{uid}).
    function isEvaluationPlanManager(schoolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/evaluationPlanManagers/$(request.auth.uid));
    }

    // ── /studentRegistrations — 학생 자동 등록용 이메일 색인 ───────
    match /studentRegistrations/{email} {
      allow get: if isSignedIn() && email == request.auth.token.email;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() || isTeacher(request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isTeacher(resource.data.schoolId);
    }

    // ── /schoolDomains — get만 허용 (auth 흐름 자기 도메인 조회) ──────
    match /schoolDomains/{domain} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── /kioskPairingCodes — 호출 시스템 기기 페어링 코드 ─────────
    // 발급·검증 모두 콜러블 함수(Admin SDK)에서만 처리하므로 클라이언트 접근은 전면 차단.
    // (코드를 클라이언트가 조회할 수 있으면 무작위 대입으로 기기 권한을 탈취할 수 있음)
    match /kioskPairingCodes/{code} {
      allow read, write: if false;
    }

    // ── /auditLogs ──────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();  // SchoolSetup·SuperAdmin 모두 기록
      allow update, delete: if isSuperAdmin();
    }

    // ── /users ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['pending', 'student', 'school_admin', 'teacher'];
      allow update: if isSuperAdmin() || isAdmin() ||
                    (isSignedIn() && request.auth.uid == uid &&
                     request.resource.data.role == resource.data.role &&
                     request.resource.data.schoolId == resource.data.schoolId) ||
                    // [M-2] 게스트 → 실제 학교 전환: role은 pending/teacher만 허용 (admin 제외)
                    (isSignedIn() && request.auth.uid == uid &&
                     resource.data.schoolId.matches('guest_.*') &&
                     request.resource.data.role in ['pending', 'teacher']) ||
                    // [M-4] 학생 이메일 패턴으로 본인 역할 복구 (rejected/pending → student)
                    (isSignedIn() && request.auth.uid == uid &&
                     resource.data.role in ['rejected', 'pending'] &&
                     request.resource.data.role == 'student' &&
                     request.auth.token.email.matches('[0-9]{9}@.*'));
      allow delete: if isSuperAdmin();
      // 같은 학교 구성원 목록은 소속 교사도 조회할 수 있어야 한다.
      // 쪽지 받는 사람 선택과 대시보드 구성원 명단이 이 목록을 쓰는데, 관리자만 허용하면
      // 일반 교사에게는 두 기능이 통째로 막힌다 (권한 오류로 조용히 실패했었음).
      //
      // 클라이언트가 where('schoolId','==',내학교)로 좁혀 조회하고, 아래 조건이 문서마다
      // 그 값을 다시 검증하므로 다른 학교 계정은 결과에 섞이지 않는다.
      // getUserData()는 모든 문서에서 같은 경로라 규칙 엔진이 한 번만 읽는다.
      allow list: if isSuperAdmin() || isAdmin() ||
                  (isSignedIn() && resource.data.schoolId == getUserData().schoolId);
    }

    // ── /schools ─────────────────────────────────────────────────
    match /schools/{schoolId} {
      // [H-1] get/list 분리 — list는 관리자만, 단건 get은 SchoolSetup 미가입자도 허용
      allow get: if isSuperAdmin() || isTeacher(schoolId) || isSignedIn();
      // [FIX] list는 원래 관리자/소속 교사만 허용하려 했으나, schoolId는 문서마다 달라지는
      // 와일드카드라 컬렉션 전체를 조회하는 list 쿼리에서는 isTeacher(schoolId)가 절대 참이 될 수
      // 없어 SchoolSetup의 학교 검색이 슈퍼 어드민 외 전원에게 permission-denied로 막혀 있었음.
      // users 문서가 아직 없는(온보딩 전) 계정과 rejected 계정은 학교 목록을 조회할 수 있어야
      // SchoolSetup에서 소속 학교를 찾아 가입 신청할 수 있다.
      allow list: if isSuperAdmin() || isTeacher(schoolId) ||
        (isSignedIn() &&
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
           getUserData().role == 'rejected'));
      // 일반 사용자: school- 접두사 학교만 생성 가능 (SchoolSetup 자동 생성)
      allow create: if isSuperAdmin() ||
        (isSignedIn() && schoolId.matches('school-.*') && request.resource.data.createdBy == request.auth.token.email) ||
        (isSignedIn() && schoolId.matches('guest_.*') && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isSuperAdmin() || isSchoolAdmin(schoolId);
      allow delete: if isSuperAdmin();

      // 보강 신청 — 소속 학교 구성원만 ────────────────────────────
      match /coverRequests/{requestId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow create: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow update: if isSuperAdmin() || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      match /teachers/{teacherId} {
        allow read, write: if isSuperAdmin() || isTeacher(schoolId);
      }

      // tasks 컬렉션은 업무 요청(requests)으로 통합되면서 제거했다.
      // 담당자를 여럿 지정해도 status가 하나뿐이라 "누가 안 했나"를 물을 수 없는 구조였고,
      // 할 일 목록이 요청과 둘로 갈려 있는 것도 문제였다. 남은 문서는 접근 경로가 없다.

      // 전체 공지(announcements)는 업무 글(requests)의 kind='notice'로 통합됐다.
      // 관리자만 쓸 수 있었으나 실제로 안내를 내는 사람은 교무부 담당 교사라 권한이 맞지
      // 않았고, 요청과 필요한 것이 같아 화면·모델을 한 벌로 합쳤다.

      // 학사일정 — 관리자만 쓰기, 소속 교사 전체 읽기
      match /academicCalendar/{eventId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 개인 쪽지 — 발신자만 생성, 발신자·수신자만 읽기/삭제.
      // 읽음 처리(readAt)는 수신자가 update로 하므로 발신자·수신자 모두 update 허용 범위에 둔다
      // (본문 위·변조는 클라이언트 UI에서 막고, 규칙은 문서 소유 여부까지만 판정한다).
      match /personalNotices/{noticeId} {
        allow read: if isSuperAdmin() ||
          (isTeacher(schoolId) && (
            resource.data.senderUid == request.auth.uid ||
            resource.data.recipientUid == request.auth.uid
          ));
        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.resource.data.senderUid == request.auth.uid);
        // 받는 사람은 읽음 표시와 자기 쪽 삭제 표시만 건드린다.
        //
        // 예전에는 받는 사람에게도 문서 전체 수정을 열어뒀는데, 그러면 받은 쪽지의 제목과
        // 본문을 자기가 고쳐놓을 수 있다. 보낸 사람의 보낸함에도 그 값이 그대로 보이므로
        // "내가 이렇게 안 썼는데" 하는 상황이 생기고, 무엇이 원본인지 가릴 방법이 없다.
        //
        // 삭제는 문서를 지우지 않고 각자 숨긴다(deletedByRecipientAt/deletedBySenderAt).
        // 문서 하나를 양쪽이 함께 보므로, 진짜 지우면 받은 사람이 보낸 사람의 기록까지
        // 없앨 수 있다.
        allow update: if isSuperAdmin() ||
          (isTeacher(schoolId) && resource.data.senderUid == request.auth.uid) ||
          (isTeacher(schoolId) &&
           resource.data.recipientUid == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['readAt', 'deletedByRecipientAt']));

        allow delete: if isSuperAdmin() ||
          (isTeacher(schoolId) && resource.data.senderUid == request.auth.uid);
      }

      // 업무 요청 — 사람마다 완료 여부가 생기는 일 (원안 제출, 성적 마감 등)
      //
      // 만들기는 소속 교사 누구나 할 수 있다. 지금도 쿨메신저로 누구나 전체 발송이 되고,
      // 여기서는 최소한 누가 만들었는지가 남는다.
      //
      // 완료 표시가 이 규칙의 핵심이다. 대상 교사는 요청 문서의 completedUids에 자기 uid만
      // 넣고 뺄 수 있어야 하고, 제목·마감일·대상 명단은 건드릴 수 없어야 한다.
      // 채널 — 업무 글이 모이는 곳. 글에 붙는 이름표라 별도 글 컬렉션이 없다.
      //
      // ── 공개 채널은 이름을 감추지 않는다 ──
      // 참여자만 읽게 하면 채널 이름조차 볼 수 없어 "그 채널에 넣어달라"는 말을 꺼낼 수가
      // 없다. 그래서 공개 채널은 소속 교사 전체가 읽는다.
      //
      // ── 비공개 채널은 존재 자체를 감춘다 (2026-08-24 신설) ──
      // 특수교육처럼 학생 개인정보가 오가는 자리가 실제로 있어서, 이름만 보이는 것으로도
      // 곤란한 채널이 필요하다. visibility == 'private'이면 참여자가 아닌 사람에게는
      // 목록·직접 URL 어디에서도 잡히지 않는다.
      //
      // 두 조건이 쿼리로 증명 가능해야 한다는 점이 중요하다. 규칙은 필터가 아니라서,
      // 읽을 수 없는 문서를 돌려줄 가능성이 있으면 쿼리 전체가 실패한다. 클라이언트는
      // where('memberUids','array-contains',uid)로 뽑으므로 두 번째 조건이 이를 만족한다.
      //
      // ── 관리자 ──
      // 학교 관리자(교감·교장)는 업무 채널을 볼 수 있지만 DM은 못 본다. DM을 "이름 없는
      // 2인 채널"로 통합한 탓에 예외를 두지 않으면 관리자가 전 교직원의 1:1 대화를
      // 열람하게 된다. 현행 personalNotices 규칙도 같은 이유로 학교 관리자를 막고 있다.
      // 슈퍼 관리자(학교 밖 시스템 운영자)는 읽기에서 아예 뺐다 — 다학교로 확장 중이라
      // 운영자가 남의 학교 비공개 채널을 볼 이유가 없다.
      //
      // 고치기를 만든 사람과 관리자로 묶는 이유: 참여자 조건을 아무나 바꾸면 대상이
      // 조용히 넓어지거나 좁아지는데, 그 변화가 채널을 열기 전에는 드러나지 않는다.
      match /channels/{channelId} {
        // visibility·memberUids는 .get(기본값)으로 감싸지 않는다. 감싸면 규칙 엔진이
        // where('memberUids','array-contains',uid) 쿼리와 이 조건을 맞물릴 수 없어
        // 채널 목록 쿼리가 통째로 거부된다. 그래서 백필을 먼저 돌렸다
        // (functions/migrations/backfillChannelVisibility.js).
        //
        // type만 .get()으로 읽는다. 아직 type으로 거르는 쿼리가 없어 안전성 증명과
        // 무관하고, 어쩌다 필드가 빠진 문서가 있어도 관리자 조항에서 평가가 터지지 않는다.
        allow read: if
          (isTeacher(schoolId) && (
            resource.data.visibility == 'public' ||
            request.auth.uid in resource.data.memberUids
          )) ||
          (isSchoolAdmin(schoolId) && resource.data.get('type', 'channel') == 'channel');

        // 만들면서 남을 미리 '나간 사람'으로 박아둘 수 없게 한다.
        //
        // dm_ 으로 시작하는 ID는 DM에만 내준다. 안 그러면 아무나 dm_A_B 자리에 공개 채널을
        // 하나 만들어 두는 것만으로 A와 B가 영영 DM을 못 열게 막을 수 있다(그 ID는 이미
        // 차 있고, 두 사람은 다른 ID를 쓸 방법이 없다).
        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) &&
           request.resource.data.createdBy == request.auth.uid &&
           request.resource.data.get('leftUids', []).size() == 0 &&
           (channelId.matches('^dm_.*')
             ? isValidDmCreate(channelId)
             : request.resource.data.get('type', 'channel') != 'dm'));

        // 참여자 명단·보관·갱신은 만든 사람과 관리자, 나가기는 본인.
        //
        // 나가기를 leftUids라는 별도 필드로 둔 덕에 이 둘을 규칙에서 가를 수 있다.
        // memberUids에서 자기를 빼는 방식이었다면 "명단을 고치는 일"과 "나가는 일"이
        // 같은 필드의 같은 변경이라, 나갈 수 있는 사람은 남을 내보낼 수도 있게 된다.
        //
        // .get('leftUids', []) 로 읽는 이유: 이 필드가 생기기 전에 만들어진 채널 문서에는
        // 값이 없어서 resource.data.leftUids 로 바로 읽으면 규칙 평가가 실패한다.
        //
        // DM은 만든 사람도 관리자도 고치지 못한다. 참여자를 한 명 더 넣으면 2인 대화가
        // 아니게 되는데 문서 ID는 여전히 두 사람을 가리켜, ID가 뜻을 잃는다. 학교 관리자를
        // 빼는 것도 같은 이유다 — 읽지 못하게 해놓고 고치게 두면 §10의 예외가 반쪽이 된다.
        // 남는 것은 메시지를 보낼 때의 lastMessageAt 하나뿐이다.
        allow update: if isSuperAdmin() ||
          (resource.data.get('type', 'channel') == 'dm'
            ? (isTeacher(schoolId) &&
               request.auth.uid in resource.data.memberUids &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt']))
            : (isSchoolAdmin(schoolId) ||
               (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid) ||
               (isTeacher(schoolId) &&
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['leftUids', 'updatedAt']) &&
                selfOnlyUidChange('leftUids')) ||
               // 디렉터리에서 둘러보다 공개 채널에 스스로 들어간다.
               //
               // **공개 채널에만 연다.** 비공개는 참여자 명단이 곧 글 열람 권한이라
               // (visibleUids, §3) 스스로 들어갈 수 있으면 남의 글을 읽는 길이 열린다.
               // 공개 채널은 어차피 교직원 누구나 읽을 수 있어서 새로 얻는 권한이 없다.
               //
               // leftUids를 같이 여는 이유: 예전에 나갔던 채널이면 명단에만 넣고 나감 표시를
               // 그대로 두면 참여자인데 목록에는 '나간 채널'로 남는다. 둘 다 자기 uid만
               // 움직이는지 검사하므로 남을 넣거나 내보낼 수는 없다.
               (isTeacher(schoolId) &&
                resource.data.visibility == 'public' &&
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['memberUids', 'leftUids', 'updatedAt']) &&
                selfOnlyUidChange('memberUids') &&
                selfOnlyUidChange('leftUids')) ||
               // 메시지를 보내면 참여자가 lastMessageAt을 갱신한다. 이 값 하나로 사이드바
               // 안읽음 점이 계산되므로(추가 읽기 0회), 참여자에게 열지 않으면 메시지 자체를
               // 보낼 수 없다. 바꿀 수 있는 키를 이것 하나로 못 박아 명단·이름은 못 건드리게 한다.
               (isTeacher(schoolId) &&
                request.auth.uid in resource.data.memberUids &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt']))));

        // DM은 지울 수 없다. 한쪽이 지우면 상대의 대화까지 함께 사라지는데, 상대에게는
        // 어제 있던 대화가 오늘 없어진 것으로만 보인다.
        allow delete: if isSuperAdmin() ||
          (resource.data.get('type', 'channel') != 'dm' &&
           (isSchoolAdmin(schoolId) ||
            (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid)));

        // ── 채널 메시지 (2026-08-24, P2) ──
        //
        // 되묻는 말과 그 답. 업무 글과 달리 완료·마감·대상이 없다. 이걸 업무 글로 만들게
        // 하면 아무도 안 쓴다 — 되묻기 하나에 제목·대상·마감을 정하라는 셈이기 때문이다.
        //
        // 고치기를 막는 것은 댓글과 같은 판단이다. 편집 화면이 없는데 규칙이 코드보다
        // 넓으면 나중에 콘솔이나 SDK로 남의 눈에 안 띄게 말을 바꿔놓을 수 있다.
        match /messages/{messageId} {
          allow read: if isChannelMember(schoolId, channelId) ||
            // 학교 관리자는 업무 채널만. DM은 제외한다 — 통합 설계 탓에 예외를 두지 않으면
            // 관리자가 전 교직원의 1:1 대화를 열람하게 된다.
            (isSchoolAdmin(schoolId) &&
             channelData(schoolId, channelId).get('type', 'channel') == 'channel');

          allow create: if isChannelMember(schoolId, channelId) &&
            request.resource.data.authorUid == request.auth.uid &&
            channelAllowsPost(schoolId, channelId);

          allow update: if false;

          // 글쓴이에게 남의 메시지 삭제 권한을 주지 않는다(댓글과 같은 이유) —
          // 채널 주인이 불편한 질문을 지울 수 있으면 "답을 모두가 함께 본다"가 깨진다.
          allow delete: if isSchoolAdmin(schoolId) ||
            (isTeacher(schoolId) && resource.data.authorUid == request.auth.uid);
        }
      }

      // ── 업무 글의 열람 범위 (2026-08-24) ──
      // 채널만 숨기고 글을 그대로 두면 이름만 안 보일 뿐 내용은 다 읽힌다. 그래서 글에도
      // 같은 판정을 복사해 둔다(channels.js의 postVisibilityFor).
      //
      // 채널 문서를 get()으로 읽어 참여자를 확인하는 방식은 쓸 수 없다. 목록 쿼리 하나가
      // 서로 다른 채널 수십 개의 글을 돌려주므로 문서 접근 횟수 상한에 걸리고, 문서마다
      // 결과가 달라지는 조건이라 쿼리 안전성도 증명되지 않는다. 값을 글에 복사해 둔다.
      //
      // 공개 글에는 visibleUids를 넣지 않는다 — 넣으면 교직원 uid가 글마다 복제되고
      // 인사이동 한 번에 학교 전체 글을 갱신해야 한다. 그래서 조건이 두 갈래이고,
      // 클라이언트도 리스너를 두 개로 나눠 합집합을 쓴다(useChannels.js).
      match /requests/{requestId} {
        // 네 갈래인 이유는 관대해서가 아니라, **클라이언트가 쓰는 쿼리마다 맞물릴 조건이
        // 하나씩 있어야 하기 때문**이다. 규칙은 필터가 아니라서 쿼리가 이 중 어느 하나도
        // 보장하지 못하면 통째로 거부된다. 실제로 visibility/visibleUids만 두었더니
        // 홈 화면과 데스크톱 알림(targetUids 기반)이 조용히 죽었다 — 규칙 테스트로 잡았다.
        //
        //   visibility == 'school'  ← useChannels의 공개 글 리스너
        //   uid in visibleUids      ← useChannels의 비공개 글 리스너
        //   uid in targetUids       ← useHomeFeed·useDesktopNotifications·CommandPalette
        //   createdBy == uid        ← RequestList의 '내가 보낸 글'·CommandPalette
        //
        // 뒤의 둘은 의미로도 옳다. 나에게 온 글과 내가 쓴 글을 못 읽으면 그건 기능이 아니다.
        allow read: if isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && (
            resource.data.visibility == 'school' ||
            request.auth.uid in resource.data.visibleUids ||
            request.auth.uid in resource.data.targetUids ||
            resource.data.createdBy == request.auth.uid
          ));

        // 공지 전용 채널의 쓰기 제한은 화면(canPostTo)과 여기 둘 다에 둔다. 화면에만 두면
        // SDK로 바로 쓸 수 있어 "만든 사람만 씁니다"라는 말이 사실이 아니게 된다.
        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) &&
           request.resource.data.createdBy == request.auth.uid &&
           request.resource.data.completedUids.size() == 0 &&
           (request.resource.data.get('channelId', null) == null ||
            isSchoolAdmin(schoolId) ||
            channelAllowsPost(schoolId, request.resource.data.channelId)));

        // 요청 내용 수정·마감은 만든 사람과 관리자만
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid) ||
          // 대상 교사의 완료 토글 — 바뀌는 필드도, 그 안에서 움직이는 uid도 제한한다
          (isTeacher(schoolId) &&
           request.auth.uid in resource.data.targetUids &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['completedUids', 'updatedAt']) &&
           selfOnlyUidChange('completedUids'));

        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);

        // 댓글 — 업무 글에 되묻는 말과 그 답.
        //
        // 쓰기를 대상자로 좁히지 않는 이유: 되묻는 말은 담당자에게만 생기는 것이 아니고,
        // 같은 질문에 대한 답을 여럿이 함께 보는 것이 이 기능의 요점이다.
        //
        // 고치기를 막는 이유: 편집 화면이 없다. 규칙이 코드보다 넓으면 나중에 누군가
        // 콘솔이나 SDK로 남의 눈에 안 띄게 말을 바꿔놓을 수 있다.
        //
        // 글쓴이에게 남의 댓글 삭제 권한을 주지 않는다. 자기 글에 달린 불편한 질문을
        // 지울 수 있으면 "답을 모두가 함께 본다"가 깨진다. 대신 글을 지울 때 남의 댓글은
        // 정리되지 않고 남는다(requestActions.js의 deletePost는 되는 데까지만 지운다).
        // 화면에서 닿을 수 없는 문서라 새어나가지는 않지만, 완전히 걷어내려면 관리자가
        // 지우거나 재귀 삭제를 함수로 옮겨야 한다.
        match /comments/{commentId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);

          allow create: if isSuperAdmin() ||
            (isTeacher(schoolId) &&
             request.resource.data.authorUid == request.auth.uid &&
             request.resource.data.body is string &&
             request.resource.data.body.size() > 0);

          allow update: if false;

          allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
            (isTeacher(schoolId) && resource.data.authorUid == request.auth.uid);
        }

        // 완료 상세(시각·비고). 문서 ID가 곧 uid다.
        // 읽기를 소속 교사 전체에 여는 이유는 현황 화면이 누가 언제 했는지를 보여주기 때문.
        // 어차피 요청 문서의 completedUids로 완료 여부는 드러나므로 새로 노출되는 정보가 아니다.
        match /completions/{completionUid} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);
          allow write: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
            // 본인이 체크
            (isTeacher(schoolId) && completionUid == request.auth.uid) ||
            // 담당자가 확인 후 대신 체크 (완료 버튼을 안 누르는 사람이 반드시 있다)
            (isTeacher(schoolId) &&
             get(/databases/$(database)/documents/schools/$(schoolId)/requests/$(requestId))
               .data.createdBy == request.auth.uid);
        }
      }

      // 대시보드 위젯 노출 제어 — 관리자만 쓰기, 소속 교사 전체 읽기
      // (자신이 대상인지는 department/uid 비교로 클라이언트가 판정 — enabled 여부만 서버가 강제)
      match /dashboardModules/{moduleId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 학생 — 소속 학교 구성원만 ──────────────────────────────────
      match /students/{studentId} {
        // 학생 본인도 자신의 학생 정보를 읽을 수 있음 (QR 체크인용)
        // 문서 ID는 Workspace User ID(마이그레이션 후) 또는 학번(레거시)이라 학번과
        // 항상 일치한다고 볼 수 없다. resource.data.studentId 필드로 비교해야 한다.
        allow read: if isSuperAdmin() || isTeacher(schoolId) ||
          (isStudent(schoolId) && resource.data.studentId == getUserData().studentId);
        allow write: if isSuperAdmin() || isTeacher(schoolId);
      }

      // 연도별 교원 배정 정보(담당교과·부서·담임·좌석·직함) — 조회는 소속 교사 전체, 쓰기는 관리자만
      match /teacherAssignments/{assignmentId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교육과정 과목 정보 (입학년도-학년-학기별) — 조회는 소속 교사 전체, 쓰기는 관리자만
      match /subjects/{subjectId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교사 과목 배정 (학기별 담당 과목) — 조회는 소속 교사 전체, 쓰기는 관리자만
      match /teacherSubjects/{subjectAssignmentId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교사 재실 상태 — 본인만 쓰고, 소속 교사와 키오스크(자리 표시용)가 읽는다.
      // Electron 데스크톱 클라이언트도 같은 규칙으로 본인 문서를 자동 갱신한다(source: 'desktop').
      match /presence/{uid} {
        allow read: if isSuperAdmin() || isTeacher(schoolId) || isKioskDevice(schoolId);
        allow write: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.auth.uid == uid);
      }

      // 데스크톱 클라이언트 설치 현황 — 본인만 쓰고, 관리자만 읽는다.
      // 누가 몇 버전을 쓰는지는 배포·지원용 정보라 교사 전체에 열 이유가 없다
      // (0.1.5 이하는 자동 업데이트가 없어 수동 재설치 안내 대상을 골라내는 데 쓴다).
      match /desktopClients/{uid} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow write: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.auth.uid == uid);
      }

      // 사무실 자리 배치 (교사 카드 좌표) — 조회는 소속 교사, 편집은 관리자만.
      // 키오스크는 getKioskTeachers 콜러블을 통해 받으므로 직접 읽기 권한은 주지 않는다.
      match /officeLayouts/{layoutId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 선생님 호출 — 생성은 콜러블(submitCallRequest)에서만 처리하므로 클라이언트 create 금지.
      // 현황판 기기는 자기 사무실 호출만 읽고, 확인·완료 처리는 로그인한 교사만 가능.
      match /callRequests/{requestId} {
        // list는 반환되는 모든 문서에 대해 이 규칙이 통과해야 성공하므로,
        // 키오스크가 office 필터 없이 전체를 조회하면 자동으로 거부된다.
        allow read: if isSuperAdmin() || isTeacher(schoolId) ||
          (isKioskDevice(schoolId) && resource.data.office == request.auth.token.kioskOffice);
        allow create: if false;
        allow update: if isSuperAdmin() || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      match /studentGroups/{groupId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId) ||
          (isSignedIn() && resource.data.createdBy == request.auth.uid) ||
          (isStudent(schoolId) && resource.data.studentIds.hasAny([getUserData().studentId]));
        allow write: if isSuperAdmin() || isTeacher(schoolId) ||
          (isSignedIn() && (resource.data.createdBy == request.auth.uid ||
                            request.resource.data.createdBy == request.auth.uid));
      }

      match /courses/{courseId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isTeacher(schoolId);
      }

      // 이벤트 — QR 체크인(공개 get) 허용 ─────────────────────────
      match /events/{eventId} {
        allow get: if true;  // QR 체크인: 미로그인 학생 접근
        allow list: if isSuperAdmin() || isTeacher(schoolId) || isStudent(schoolId);
        allow write: if isSuperAdmin() || isTeacher(schoolId);

        match /attendanceLogs/{logId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);
          // 학생 본인의 출결 로그 확인 (중복 체크인 방지용 get)
          allow get: if isStudent(schoolId) &&
            (resource == null || resource.data.studentId == getUserData().studentId);
          // 학생: 순위 계산용 list (같은 학교 학생끼리 출석 현황 확인)
          allow list: if isStudent(schoolId);
          // [H-2] isSignedIn() 추가 — QR 토큰만으로 비로그인 쓰기 불가
          allow write: if isSuperAdmin() || isTeacher(schoolId) ||
            (isSignedIn() && (
              get(/databases/$(database)/documents/schools/$(schoolId)/events/$(eventId)).data.qrToken
                == request.resource.data.qrToken ||
              get(/databases/$(database)/documents/schools/$(schoolId)/events/$(eventId)).data.liveToken
                == request.resource.data.qrToken
            ));
        }

      }

      match /trainings/{trainingId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow create: if isSuperAdmin() || isTeacher(schoolId);
        allow update: if isSuperAdmin() || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isAdmin() ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);

        match /signatures/{signatureId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId);
          allow write: if isSuperAdmin() ||
            (isTeacher(schoolId) && request.auth.uid == signatureId);
        }
      }

      match /trainingPresets/{presetId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isAdmin();
      }

      // 스마트 공지 — 본인 공지 쓰기, 소속 학교 구성원 읽기
      match /notices/{noticeId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId) || isStudent(schoolId);
        allow write: if isSuperAdmin() ||
          (isTeacher(schoolId) && (
            resource == null || resource.data.teacherId == request.auth.uid
          ));

        // 공지 확인 기록 — 학생 본인만 쓰기, 교사는 읽기 가능
        match /confirmations/{confirmedStudentId} {
          allow read: if isSuperAdmin() || isTeacher(schoolId) ||
            (isStudent(schoolId) && getUserData().studentId == confirmedStudentId);
          allow create, update: if isSuperAdmin() ||
            (isStudent(schoolId) && getUserData().studentId == confirmedStudentId);
          allow delete: if isSuperAdmin() || isTeacher(schoolId);
        }
      }

      // [M-3] preApproved — 본인 이메일 문서만 get 허용, 목록은 해당 학교 관리자 이상
      // [FIX] 문서 ID는 이메일을 변환한 값(emailToDocId)이라 emailId와 원본 이메일이 항상
      // 달라 get이 실질적으로 막혀 있었음 — 문서 데이터의 email 필드로 비교하도록 수정
      match /preApproved/{emailId} {
        allow get: if isSignedIn() && resource.data.email == request.auth.token.email;
        allow list: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // ── 성취평가제 운영 체크리스트 (ASA-checklist) ──────────────
      // 과목 — 관리자만 생성/수정, 교사·교감은 조회
      match /asaSubjects/{subjectId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 나이스 담당과목 업로드 이력 — 관리자만 (교사 로스터 데이터, 관리 목적 전용)
      match /asaNeisImports/{importId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 제출물 — 배정된 교사·교감은 읽기/수정, 관리자는 전체, 잠금(locked) 후 수정 불가
      // 배정 여부는 문서 자체의 teacherEmails(스냅샷)가 아니라 asaSubjects의 실시간 값으로 판단
      match /asaSubmissions/{submissionId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) || isPrincipal(schoolId) ||
          (isTeacher(schoolId) && isAssignedToAsaSubject(schoolId, resource.data.subjectId));
        allow create: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && isAssignedToAsaSubject(schoolId, request.resource.data.subjectId));
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) || isPrincipal(schoolId) ||
          (isTeacher(schoolId) &&
           isAssignedToAsaSubject(schoolId, resource.data.subjectId) &&
           resource.data.status != 'locked');
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 교감 서명 재사용 저장소 — 본인만 읽기/쓰기, 관리자는 읽기
      match /asaPrincipalSignature/{uid} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isSignedIn() && request.auth.uid == uid);
        allow write: if isSuperAdmin() ||
          (isPrincipal(schoolId) && request.auth.uid == uid);
      }

      // 성취평가제 체크리스트 지원 도구 (ASA-support)
      // 분할점수 기준 — 조회는 소속 교사 전체, 등록/수정/삭제는 관리자만
      match /asaCutoffs/{cutoffId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 분석 결과 — 업로드한 본인 교사만 조회/수정/삭제 (관리자는 전체 열람 가능)
      match /asaResults/{resultId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);
        allow create: if isSuperAdmin() ||
          (isTeacher(schoolId) && request.resource.data.createdBy == request.auth.uid);
        allow update, delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.createdBy == request.auth.uid);
      }

      // 최소성취수준 보장지도 결과 — 조회는 소속 교사 전체, 쓰기는 본인 doc만 (관리자는 전체)
      match /minAchievementResults/{resultId} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow create, update: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resultId.matches(request.auth.uid + '_.*'));
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resultId.matches(request.auth.uid + '_.*'));
      }

      // ── 교수학습 및 평가 운영 계획 제출 ────────────────────────
      // 업무 담당자 지정 목록 — 학교 전체 단일 목록. 존재 여부만으로 담당자인지 판정하므로
      // uid를 문서 ID로 쓴다. 읽기를 소속 교사 전체로 여는 이유: "담당자에게 문의하세요"
      // 안내를 프론트에서 보여주려면 담당자 이름 정도는 모든 교사가 조회할 수 있어야 한다.
      match /evaluationPlanManagers/{uid} {
        allow read: if isSuperAdmin() || isTeacher(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // 제출물 — 제출자 본인 + 매칭된 공동 지도교사 + 업무 담당자 + 관리자만 조회.
      // hwpx meta.teachers(teacherNames)는 표시용 원문 텍스트일 뿐 권한 판정에 못 쓰지만,
      // matchedTeacherUids는 그 이름들을 실제 계정과 매칭해 만든 uid 평면 배열이라 배열
      // 필드 규칙(array-contains 상당)으로 판정할 수 있다 — 제출은 한 명이 해도 공동
      // 지도교사 전원이 본인 담당 과목의 계획을 볼 수 있어야 한다는 요구에 따른 것.
      // 쓰기 권한(update/delete)은 여전히 소유자(uploaderUid)에게만 둔다.
      match /evaluationPlans/{planId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          isEvaluationPlanManager(schoolId) ||
          (isTeacher(schoolId) &&
           (resource.data.uploaderUid == request.auth.uid ||
            request.auth.uid in resource.data.get('matchedTeacherUids', [])));

        allow create: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) &&
           request.resource.data.uploaderUid == request.auth.uid &&
           request.resource.data.year is int &&
           request.resource.data.semester in [1, 2] &&
           request.resource.data.status in ['draft', 'confirmed']);

        // 소유자(uploaderUid) 변경은 금지 — 데이터 수정, draft→confirmed 전환은 자유롭게 허용.
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) &&
           resource.data.uploaderUid == request.auth.uid &&
           request.resource.data.uploaderUid == resource.data.uploaderUid);

        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.uploaderUid == request.auth.uid);
      }
    }
  }
}
