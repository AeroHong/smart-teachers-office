{
  "name": "seonyoo-smart-office",
  "version": "2.0.0",
  "description": "선유고 스마트 교무실 — 포털 + 출결 + 보강신청 통합",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/portal/vite.config.js",
    "build": "vite build --config apps/portal/vite.config.js",
    "deploy": "npm run build && firebase deploy --only hosting:seonyoo,hosting:smart-school",
    "preview": "vite preview --config apps/portal/vite.config.js",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.js",
    "build:dashboard": "vite build --config apps/dashboard/vite.config.js",
    "deploy:dashboard": "npm run build:dashboard && firebase deploy --only hosting:dashboard",
    "preview:dashboard": "vite preview --config apps/dashboard/vite.config.js",
    "dev:kiosk": "vite --config apps/kiosk/vite.config.js",
    "build:kiosk": "vite build --config apps/kiosk/vite.config.js",
    "deploy:kiosk": "npm run build:kiosk && firebase deploy --only hosting:kiosk",
    "preview:kiosk": "vite preview --config apps/kiosk/vite.config.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@google-cloud/secret-manager": "^6.3.0",
    "@mui/icons-material": "^5.16.0",
    "@mui/material": "^5.16.0",
    "exceljs": "^4.4.0",
    "firebase": "^10.7.1",
    "firebase-admin": "^14.2.0",
    "googleapis": "^173.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "signature_pad": "^5.1.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.10"
  }
}
