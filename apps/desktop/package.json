{
  "name": "smart-office-desktop",
  "version": "0.1.8",
  "private": true,
  "description": "선유고 스마트교무실 — 대시보드 데스크톱 트레이 앱",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder && node scripts/copy-release.js"
  },
  "build": {
    "appId": "kr.seonyoo.smartoffice",
    "productName": "스마트교무실",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://smart-school-updates.web.app/",
      "channel": "latest"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
